# Copy to .env for local `netlify dev` — never commit .env
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@nexpertsai.com
BREVO_SENDER_NAME=Nexperts Academy
# Lead inbox (student reply-to + internal notification). Same as teamInbox in js/enquiry-config.js.
# Aliases also read: BREVO_ENQUIRY_TO, NEXPERTS_ENQUIRY_EMAIL, ENQUIRY_EMAIL. Comma-separated = multiple recipients.
BREVO_INTERNAL_TO=enquiry@nexpertsacademy.com

# Optional override for sheet logging with Brevo (defaults to webAppUrl in js/enquiry-config.js if empty).
APPS_SCRIPT_ENQUIRY_URL=
# Set to 1 to stop forwarding enquiries to Google Sheets (Phase 4 retire-the-sheet).
# APPS_SCRIPT_ENQUIRY_DISABLED=1
# If set, must match `secret` in js/enquiry-config.js and ENQUIRY_SECRET in Apps Script (when used). Used for sheet forward too.
BREVO_ENQUIRY_SECRET=

# Optional: override only for Apps Script (else BREVO_ENQUIRY_SECRET / client secret is sent)
# APPS_SCRIPT_ENQUIRY_SECRET=

# Optional — links inside HTML emails (defaults shown)
# NEXPERTS_PUBLIC_SITE_URL=https://www.nexpertsacademy.com
# NEXPERTS_LEADS_SHEET_URL=https://docs.google.com/spreadsheets/d/.../edit

# Zoho CRM (website enquiry → Lead upsert). Leave blank to skip CRM locally.
# See docs/zoho/PHASE_0_SETUP.md — never put these in js/enquiry-config.js.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_API_DOMAIN=https://www.zohoapis.com
# ZOHO_API_VERSION=v8
# ZOHO_LEAD_STATUS=Not Contacted
# After Standard edition custom fields exist:
# ZOHO_USE_CUSTOM_FIELDS=1
# ZOHO_FIELD_COURSE=Course
# ZOHO_FIELD_ENQUIRY_TYPE=Enquiry_Type
# ZOHO_FIELD_OFFICE=Preferred_Office
# ZOHO_FIELD_PAGE_URL=Page_URL
# ZOHO_FIELD_FORM_SOURCE=Form_Source
